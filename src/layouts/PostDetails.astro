---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import InlineVideo from "@/components/InlineVideo.astro";
import "@/styles/phone-mockup.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import ContinueReading from "@/components/ContinueReading.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import InlineToc from "@/components/InlineToc.astro";
import { getReadingMinutes } from "@/utils/readingTime";
import { getPath } from "@/utils/getPath";
import getUniqueTags from "@/utils/getUniqueTags";
import { slugifyStr } from "@/utils/slugify";
import { SITE } from "@/config";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;

const {
  title,
  ogTitle,
  author,
  description,
  ogImage: initOgImage,
  ogImageVersion,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
  hideFromFeed,
} = post.data;

const availableTagSlugs = new Set(getUniqueTags(posts).map(({ tag }) => tag));
const visibleTags = tags.filter(tag => availableTagSlugs.has(slugifyStr(tag)));

const { Content, headings } = await render(post);

// On-page TOC: h2/h3 only; render the rail when there's enough structure.
// A long post would bury its sections under repeated h3 entries, so past
// TOC_MAX_ENTRIES the rail lists h2 only.
const TOC_MAX_ENTRIES = 24;
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
const toc =
  tocHeadings.length > TOC_MAX_ENTRIES
    ? tocHeadings.filter(h => h.depth === 2)
    : tocHeadings;
const showToc = toc.length >= 3;

const readingMinutes = getReadingMinutes(post.body);

let ogImageUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src; // Local asset
}

// Use dynamic OG image if enabled and no remote|local ogImage
if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath)}index.png`;
}

// Append cache-bust query so social platforms re-fetch after regeneration
if (ogImageUrl && ogImageVersion) {
  const separator = ogImageUrl.includes("?") ? "&" : "?";
  ogImageUrl = `${ogImageUrl}${separator}v=${encodeURIComponent(ogImageVersion)}`;
}

// Resolve OG image URL (or fallback to SITE.ogImage / default `og.png`)
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  ogTitle,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
  pageType: "article" as const,
  tags,
};
---

<Layout {...layoutProps}>
  <InlineVideo />
  <Header />
  <BackButton />
  <main
    id="main-content"
    class:list={["app-layout pb-12", { "mt-8": !SITE.showBackButton }]}
    data-pagefind-body={hideFromFeed ? undefined : true}
  >
    <h1
      transition:name={slugifyStr(title.replaceAll(".", "-"))}
      class="inline-block text-2xl font-bold text-accent sm:text-3xl"
    >
      {title}
    </h1>
    <div class="my-2 flex flex-wrap items-center gap-x-2">
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
      {
        readingMinutes > 0 && (
          <span class="text-sm opacity-80 sm:text-base" data-pagefind-ignore>
            <span aria-hidden="true">·</span> {readingMinutes} min read
          </span>
        )
      }
      <span
        aria-hidden="true"
        class:list={[
          "max-sm:hidden",
          { hidden: !SITE.editPost.enabled || hideEditPost },
        ]}>|</span
      >
      <EditPost {hideEditPost} {post} class="max-sm:hidden" />
    </div>
    {showToc && <InlineToc toc={toc} />}
    <article
      id="article"
      class="app-prose mt-8 w-full max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
    >
      <Content />
    </article>

    {showToc && <TableOfContents toc={toc} />}

    <hr class="my-8 border-dashed" />

    <EditPost class="sm:hidden" {hideEditPost} {post} />

    {
      visibleTags.length > 0 && (
        <ul class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
          {visibleTags.map(tag => (
            <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />
          ))}
        </ul>
      )
    }

    <BackToTopButton />

    <ShareLinks />

    <hr class="my-6 border-dashed" />

    <ContinueReading {post} {posts} />
  </main>
  <Footer />
</Layout>

<script is:inline data-astro-rerun>
  /** Create a progress indicator
   *  at the top */
  function createProgressBar() {
    // Create the main container div
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-10 h-1 w-full bg-background";

    // Create the progress bar div
    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-accent";
    progressBar.id = "myBar";

    // Append the progress bar to the progress container
    progressContainer.appendChild(progressBar);

    // Append the progress container to the document body or any other desired parent element
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  /** Update the progress bar
   *  when user scrolls */
  function updateScrollProgress() {
    document.addEventListener("scroll", () => {
      const winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      if (document) {
        const myBar = document.getElementById("myBar");
        if (myBar) {
          myBar.style.width = scrolled + "%";
        }
      }
    });
  }
  updateScrollProgress();

  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("#article :is(h2, h3, h4, h5, h6)")
    );
    for (const heading of headings) {
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ms-2 no-underline opacity-75 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100";
      link.href = "#" + heading.id;

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      link.setAttribute(
        "aria-label",
        "Link to section: " +
          heading.textContent.trim().replace(/#$/, "").trim()
      );
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Attaches copy buttons to code blocks in the document,
   * allowing users to copy code easily. */
  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const codeBlock of codeBlocks) {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      // Check if --file-name-offset custom property exists
      const computedStyle = getComputedStyle(codeBlock);
      const fileNameOffset = computedStyle
        .getPropertyValue("--file-name-offset")
        .trim();
      const hasFileNameOffset = fileNameOffset !== "";
      // The button reads the offset by inheritance; it now lives on the
      // wrapper, so hand the block's value down to it.
      if (hasFileNameOffset) {
        wrapper.style.setProperty("--file-name-offset", fileNameOffset);
      }

      // Determine the top positioning class
      const topClass = hasFileNameOffset
        ? "top-(--file-name-offset)"
        : "-top-3";

      const copyButton = document.createElement("button");
      copyButton.className = `copy-code absolute end-3 ${topClass} rounded bg-muted border border-muted px-2 py-1 text-xs leading-4 text-foreground font-medium`;
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");

      // wrap codebock with relative parent element; the button sits beside
      // the block, not inside it, so the overflow fade never dims it
      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);
      wrapper.appendChild(copyButton);

      watchOverflow(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    /** Marks a block while more code is hidden to its right, so CSS can
     *  fade that edge as a cue to scroll sideways. */
    function watchOverflow(block) {
      const update = () => {
        const hidden = block.scrollWidth - block.clientWidth - block.scrollLeft;
        block.toggleAttribute("data-more", hidden > 4);
      };
      block.addEventListener("scroll", update, { passive: true });
      new ResizeObserver(update).observe(block);
      update();
    }

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      try {
        await navigator.clipboard.writeText(text ?? "");
        // visual feedback that task is completed
        button.innerText = "Copied";
      } catch {
        button.innerText = "Copy failed";
      }

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  /* Go to page start after page swap */
  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  );
</script>

<script>
  // Interactive research figures load only on posts that use them.
  const RESEARCH_WIDGETS =
    "bench-chart, time-ruler, inversion-timeline, actor-hops, memory-blocks";

  document.addEventListener("astro:page-load", () => {
    if (document.querySelector(RESEARCH_WIDGETS)) {
      import("../scripts/sync-bench/index");
    }
  });
</script>

<script>
  import { init, teardown } from "../scripts/reading-tracker";

  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", teardown);
</script>
