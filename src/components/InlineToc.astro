---
// Collapsed "On this page" list for viewports where the desktop tick rail
// (TableOfContents.astro, 1280px and up) is hidden.
type TocHeading = { depth: number; slug: string; text: string };

interface Props {
  toc: TocHeading[];
}

const { toc } = Astro.props;
---

<details class="toc-inline" data-pagefind-ignore>
  <summary>
    <span>On this page</span>
    <span class="toc-inline-count">{toc.length} sections</span>
    <svg
      class="toc-inline-chevron"
      viewBox="0 0 24 24"
      width="20"
      height="20"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M6 9l6 6 6-6"></path>
    </svg>
  </summary>
  <nav aria-label="On this page">
    <ol role="list">
      {
        toc.map(h => (
          <li class:list={[`depth-${h.depth}`]}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))
      }
    </ol>
  </nav>
</details>

<style>
  .toc-inline {
    margin-top: 1.25rem;
    border-block: 1px dashed var(--border);
  }

  /* The tick rail takes over from here. */
  @media (min-width: 1280px) {
    .toc-inline {
      display: none;
    }
  }

  summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    user-select: none;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--accent);
  }

  summary:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  .toc-inline-count {
    font-weight: 400;
    opacity: 0.7;
  }

  .toc-inline-chevron {
    margin-inline-start: auto;
    transition: rotate 200ms cubic-bezier(0.2, 0, 0, 1);
  }

  .toc-inline[open] .toc-inline-chevron {
    rotate: 180deg;
  }

  ol {
    margin: 0;
    padding: 0 0 0.5rem;
    list-style: none;
  }

  a {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    padding-block: 0.375rem;
    font-size: 0.875rem;
    line-height: 1.4;
    text-wrap: pretty;
  }

  a:hover {
    color: var(--accent);
  }

  .depth-3 a {
    padding-inline-start: 1rem;
    opacity: 0.8;
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-inline-chevron {
      transition: none;
    }
  }
</style>

<script>
  // Following an entry collapses the list so the heading is not pushed
  // below it; the native anchor jump does the scrolling.
  document.addEventListener("astro:page-load", () => {
    const toc = document.querySelector<HTMLDetailsElement>(".toc-inline");
    if (!toc) return;
    toc.addEventListener("click", event => {
      if ((event.target as HTMLElement).closest("a")) toc.open = false;
    });
  });
</script>
