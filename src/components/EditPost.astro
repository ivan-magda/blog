---
import type { CollectionEntry } from "astro:content";
import IconEdit from "@/assets/icons/IconEdit.svg";
import { SITE } from "@/config";

type Props = {
  hideEditPost?: CollectionEntry<"blog">["data"]["hideEditPost"];
  class?: string;
  post: CollectionEntry<"blog">;
};

const { hideEditPost, post, class: className = "" } = Astro.props;

const href = `${SITE.editPost.url}${post.filePath}`;
const showEditPost =
  SITE.editPost.enabled && !hideEditPost && href.trim() !== "";
---

{
  showEditPost && (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        /* Dimmed with a colour, not opacity: opacity composites the whole
           element, so it dragged the hover accent down to 3.23:1 in light.
           text-foreground/80 renders the same at rest (7.35:1) and lets
           hover:text-accent land at the full 4.53:1. IconEdit strokes with
           currentColor, so it tints either way. */
        "flex justify-baseline gap-1.5 text-foreground/80 hover:text-accent",
        className,
      ]}
    >
      <IconEdit class="inline-block" />
      <span>{SITE.editPost.text}</span>
    </a>
  )
}
